<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.openkawu</groupId>
    <artifactId>JFXium</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>JFXium</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.12.1</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21.0.6</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21.0.6</version>
        </dependency>

        <!-- Ikonli 图标库 -->
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>12.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-antdesignicons-pack</artifactId>
            <version>12.3.1</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>compile-less-themes</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>npx</executable>
                            <arguments>
                                <argument>lessc</argument>
                                <argument>src/main/resources/org/openkawu/jfxium/css/less/theme-light.less</argument>
                                <argument>src/main/resources/org/openkawu/jfxium/css/theme-light.css</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-less-themes-dark</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>npx</executable>
                            <arguments>
                                <argument>lessc</argument>
                                <argument>src/main/resources/org/openkawu/jfxium/css/less/theme-dark.less</argument>
                                <argument>src/main/resources/org/openkawu/jfxium/css/theme-dark.css</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- MUI Theme -->
                    <execution>
                        <id>compile-less-themes-mui</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>npx</executable>
                            <arguments>
                                <argument>lessc</argument>
                                <argument>src/main/resources/org/openkawu/jfxium/css/less/theme-mui.less</argument>
                                <argument>src/main/resources/org/openkawu/jfxium/css/theme-mui.css</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- shadcn Theme -->
                    <execution>
                        <id>compile-less-themes-shadcn</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>npx</executable>
                            <arguments>
                                <argument>lessc</argument>
                                <argument>src/main/resources/org/openkawu/jfxium/css/less/theme-shadcn.less</argument>
                                <argument>src/main/resources/org/openkawu/jfxium/css/theme-shadcn.css</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Cyberpunk Theme -->
                    <execution>
                        <id>compile-less-themes-cyberpunk</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>npx</executable>
                            <arguments>
                                <argument>lessc</argument>
                                <argument>src/main/resources/org/openkawu/jfxium/css/less/theme-cyberpunk.less</argument>
                                <argument>src/main/resources/org/openkawu/jfxium/css/theme-cyberpunk.css</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <!-- Default configuration for running with: mvn clean javafx:run -->
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>org.openkawu.jfxium/org.openkawu.jfxium.playground.JFXiumPlayground</mainClass>
                            <launcher>app</launcher>
                            <jlinkZipName>app</jlinkZipName>
                            <jlinkImageName>app</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>