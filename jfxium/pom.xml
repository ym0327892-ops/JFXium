<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.openkawu</groupId>
        <artifactId>jfxium-parent</artifactId>
        <version>1.10.0-RC1</version>

    </parent>

    <artifactId>jfxium</artifactId>
    <packaging>jar</packaging>
    <name>JFXium Core</name>
    <description>Core UI components for JFXium</description>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-antdesignicons-pack</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>


    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <!-- ============================================
                 单元测试：surefire + JavaFX 模块参数
                 ============================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>
                        --add-opens javafx.graphics/javafx.application=ALL-UNNAMED
                        --add-opens javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
                        --add-opens org.openkawu.jfxium/org.openkawu.jfxium=ALL-UNNAMED
                        --add-opens org.openkawu.jfxium/org.openkawu.jfxium.component.control=ALL-UNNAMED
                        --add-opens org.openkawu.jfxium/org.openkawu.jfxium.component.composite=ALL-UNNAMED
                        --add-opens org.openkawu.jfxium/org.openkawu.jfxium.core.builder=ALL-UNNAMED
                        --add-opens org.openkawu.jfxium/org.openkawu.jfxium.core.css=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <!-- ============================================
                 LESS → CSS 编译（纯 Java，不依赖 Node.js）
                 使用 jlessc（de.inetsoftware:jlessc:1.16）纯 Java LESS 编译器。
                 M19.46：从 exec-maven-plugin(npx lessc) 迁移而来，新机器无需安装 Node。
                 ============================================ -->
            <plugin>
                <groupId>org.codehaus.gmaven</groupId>
                <artifactId>groovy-maven-plugin</artifactId>
                <version>2.1.1</version>
                <dependencies>
                    <dependency>
                        <groupId>de.inetsoftware</groupId>
                        <artifactId>jlessc</artifactId>
                        <version>1.16</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>compile-less-themes</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <source>
                                import com.inet.lib.less.Less

                                def lessDir = new File(project.basedir, 'src/main/resources/org/openkawu/jfxium/css/less')
                                def cssDir = new File(project.basedir, 'src/main/resources/org/openkawu/jfxium/css')

                                def themes = [
                                        'theme-light', 'theme-dark',
                                        'theme-mui', 'theme-mui-compact', 'theme-mui-dark', 'theme-mui-dark-compact',
                                        'theme-shadcn', 'theme-cyberpunk', 'theme-custom',
                                        'theme-light-compact', 'theme-dark-compact'
                                ]

                                themes.each { name -&gt;
                                    def input = new File(lessDir, name + '.less')
                                    def output = new File(cssDir, name + '.css')
                                    if (!input.exists()) {
                                        log.warn('LESS source not found, skipping: ' + input)
                                        return
                                    }
                                    def css = Less.compile(input, false)
                                    if (css == null || css.length() == 0) {
                                        throw new RuntimeException('jlessc produced empty CSS for ' + name)
                                    }
                                    // 用 FileWriter 显式写入 + flush + close，避免某些 classloader 下
                                    // Files.writeString / File.text 静默失败（M19.50 实证：会假成功不落盘）
                                    def writer = new java.io.OutputStreamWriter(
                                            new java.io.FileOutputStream(output), 'UTF-8')
                                    try {
                                        writer.write(css)
                                        writer.flush()
                                    } finally {
                                        writer.close()
                                    }
                                    log.info('Compiled LESS: ' + name + '.css (' + css.length() + ' chars)')
                                }
                                log.info('All ' + themes.size() + ' themes compiled successfully (jlessc, no Node.js required)')
                            </source>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
