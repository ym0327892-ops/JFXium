<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.openkawu</groupId>
        <artifactId>jfxium-parent</artifactId>
        <version>1.33.0</version>
    </parent>

    <artifactId>jfxium-demo</artifactId>
    <packaging>jar</packaging>
    <name>JFXium Demo</name>
    <description>Demo application for JFXium UI components</description>

    <dependencies>
        <dependency>
            <groupId>org.openkawu</groupId>
            <artifactId>jfxium</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- BUG #144：删除重复的 org.openkawu:jfxium:1.20.1 依赖声明 ——
             旧版 jar 会遮蔽 reactor 当前版本（新 API 编译报找不到符号） -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <!-- mainClass 候选（按需切换）：
                         - org.openkawu.jfxium.demo.admin.AdminDemo        Web Admin 后台 demo（M12 参考实现保留）
                         - org.openkawu.jfxium.demo.showcase.ShowcaseDemo  控件 Showcase Demo
                         - org.openkawu.jfxium.jfxiumUiExample.JfxiumUiExampleApp  UI 示例项目（NEW，主入口）
                         - org.openkawu.jfxium.demo.menu.MenuInlineProbe    BUG #68 探针（验证 30px/row） -->
                    <mainClass>org.openkawu.jfxium.jfxiumUiExample.JfxiumUiExampleApp</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
